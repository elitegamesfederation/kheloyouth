rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAllowedUpload() {
      return request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType == 'application/pdf'
        );
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "jameelhawati@gmail.com";
    }

    function isOwner(academyId) {
      return isSignedIn() && request.auth.uid == academyId;
    }

    // Admin dashboard uploads on behalf of an academy.
    match /academies/{academyId}/{allAcademyFiles=**} {
      allow read: if true;
      allow write: if (isOwner(academyId) || isAdmin()) && isAllowedUpload();
    }

    // Academy self-service uploads from the affiliation form.
    match /academy-logos/{academyId}/{allFiles=**} {
      allow read: if true;
      allow write: if (isOwner(academyId) || isAdmin()) && isAllowedUpload();
    }

    match /academy-photos/{academyId}/{allFiles=**} {
      allow read: if true;
      allow write: if (isOwner(academyId) || isAdmin()) && isAllowedUpload();
    }

    match /academy-owners/{academyId}/{allFiles=**} {
      allow read: if true;
      allow write: if (isOwner(academyId) || isAdmin()) && isAllowedUpload();
    }

    match /academy-coaches/{academyId}/{allFiles=**} {
      allow read: if true;
      allow write: if (isOwner(academyId) || isAdmin()) && isAllowedUpload();
    }

    match /academy-students/{academyId}/{allFiles=**} {
      allow read: if true;
      allow write: if (isOwner(academyId) || isAdmin()) && isAllowedUpload();
    }

    match /academy-banners/{allBannerFiles=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "jameelhawati@gmail.com";
    }

    function isOwner(academyId) {
      return isSignedIn() && request.auth.uid == academyId;
    }

    function paymentFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'paymentDone',
        'paymentMode',
        'razorpayPaymentId',
        'razorpayOrderId',
        'affiliationStartDate',
        'affiliationEndDate',
        'affiliationNumber',
        'amountPaid',
        'verified'
      ]);
    }

    match /academies/{academyId} {
      allow read: if true;
      allow create: if isOwner(academyId);
      allow update: if isAdmin() || (isOwner(academyId) && paymentFieldsUnchanged());
      allow delete: if isAdmin();
    }

    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /pageViews/{viewId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
